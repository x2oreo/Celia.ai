# Copy to .env (git-ignored) and fill in. Every build turns it into the app's bundled config.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional
WATCH_DEVICE_ID=demo-watch-1
DEFAULT_SOURCE=SENSOR
MEDICATION_NAME=nadolol
# High-HR limit while active (rest/sleep limits below)
HIGH_BPM=140
REST_HIGH_BPM=120
LOW_BPM=45
SLEEP_HIGH_BPM=100
SLEEP_LOW_BPM=40
RESTING_BPM=65
# LQT1 | LQT2 | LQT3 | UNKNOWN (the phone app's watch_context row overrides it)
GENOTYPE=UNKNOWN
# Demo scenarios fast-forward: 1 | 2 | 4 | 8
DEMO_SPEED=4
# Seconds HR must stay out of range before the alert screen (filters sensor spikes)
ALERT_SUSTAIN_SEC=5
