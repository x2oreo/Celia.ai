// Real medicine boxes (F-36): the Polish medicines register (URPL) bundled offline as rawfile/gtin_pl.json -
// ~19k products / ~68k packs, generated by data/export_gtins.py. Loaded lazily on the first scan (or preloaded
// shortly after launch) and indexed by GTIN. Parsing is pure and unit tested with a small fixture.

import { common } from '@kit.AbilityKit';
import { util } from '@kit.ArkTS';
import { BoxInfo } from '../model/BoxInfo';
import { gtinCountry } from './Gs1';
import { Logger } from '../common/Logger';

const log: Logger = new Logger('GtinCatalog');

const RAWFILE: string = 'gtin_pl.json';
const LEAFLET_URL: string = 'https://rejestrymedyczne.ezdrowie.gov.pl/api/rpl/medicinal-products/%ID%/leaflet';

// File shape (see data/export_gtins.py). Product row:
// [brand, substance, ingredients, strength, formIdx, atc, holderIdx, rplId, "gtin|cat|pack;gtin|cat|pack"]
export interface CatalogFile {
  source: string;
  date: string;
  forms: string[];
  holders: string[];
  products: Array<Array<string | number>>;
}

class PackRef {
  product: number;
  category: string;
  pack: string;

  constructor(product: number, category: string, pack: string) {
    this.product = product;
    this.category = category;
    this.pack = pack;
  }
}

export class CatalogIndex {
  readonly date: string;
  private file: CatalogFile;
  private packs: Map<string, PackRef> = new Map<string, PackRef>();

  constructor(file: CatalogFile) {
    this.file = file;
    this.date = file.date;
    for (let i = 0; i < file.products.length; i++) {
      const packField: string = String(file.products[i][8]);
      for (const entry of packField.split(';')) {
        const parts: string[] = entry.split('|');
        if (parts.length >= 2 && parts[0].length > 0) {
          this.packs.set(parts[0], new PackRef(i, parts[1], parts.length > 2 ? parts[2] : ''));
        }
      }
    }
  }

  get size(): number {
    return this.packs.size;
  }

  lookup(gtin: string): BoxInfo | undefined {
    const ref: PackRef | undefined = this.packs.get(gtin);
    if (ref === undefined) {
      return undefined;
    }
    const p: Array<string | number> = this.file.products[ref.product];
    const rplId: string = String(p[7]);
    const box: BoxInfo = {
      gtin: gtin,
      brand: String(p[0]),
      substance: String(p[1]),
      ingredients: String(p[2]),
      strength: String(p[3]),
      form: this.file.forms[Number(p[4])] ?? '',
      pack: ref.pack,
      atc: String(p[5]),
      holder: this.file.holders[Number(p[6])] ?? '',
      rxCategory: ref.category,
      leafletUrl: rplId.length > 0 ? LEAFLET_URL.replace('%ID%', rplId) : '',
      country: gtinCountry(gtin),
      source: 'PL_REGISTER',
      sourceDate: this.file.date
    };
    return box;
  }
}

export function parseCatalog(json: string): CatalogIndex {
  return new CatalogIndex(JSON.parse(json) as CatalogFile);
}

export class GtinCatalog {
  private static instance: GtinCatalog | undefined = undefined;

  private context: common.Context | undefined = undefined;
  private loading: Promise<CatalogIndex | undefined> | undefined = undefined;

  static get(): GtinCatalog {
    if (GtinCatalog.instance === undefined) {
      GtinCatalog.instance = new GtinCatalog();
    }
    return GtinCatalog.instance;
  }

  // Called from EntryAbility. Preloads after launch so the first scan does not wait for the parse.
  init(context: common.Context): void {
    this.context = context;
    setTimeout(() => {
      this.load();
    }, 3000);
  }

  async lookup(gtin: string): Promise<BoxInfo | undefined> {
    const index: CatalogIndex | undefined = await this.load();
    return index?.lookup(gtin);
  }

  private load(): Promise<CatalogIndex | undefined> {
    if (this.loading === undefined) {
      this.loading = this.read();
    }
    return this.loading;
  }

  private async read(): Promise<CatalogIndex | undefined> {
    if (this.context === undefined) {
      return undefined;   // unit tests / before init
    }
    try {
      const started: number = Date.now();
      const bytes: Uint8Array = await this.context.resourceManager.getRawFileContent(RAWFILE);
      const text: string = util.TextDecoder.create('utf-8').decodeToString(bytes);
      const index: CatalogIndex = parseCatalog(text);
      log.info(`loaded ${index.size} packs (register ${index.date}) in ${Date.now() - started} ms`);
      return index;
    } catch (e) {
      log.error(`catalogue load failed: ${JSON.stringify(e)}`);
      this.loading = undefined;   // allow a retry on the next scan
      return undefined;
    }
  }
}
