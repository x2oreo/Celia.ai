# HarmonyOS / DevEco build output
**/node_modules
**/oh_modules
**/local.properties
**/.idea
**/build
**/.hvigor
.cxx
**/.clangd
**/.clang-format
**/.clang-tidy
**/.test
.appanalyzer

# Signing material and secrets
# Local backend config (copied from LocalConfig.example.ets by entry/hvigorfile.ts on first build)
**/common/LocalConfig.ets
*.p12
*.cer
*.p7b
*.csr
*.jks
*.keystore
*.pem
*.key
.env*
!.env.example

# Packaged artifacts copied outside build/ (submit via release, not git)
*.hap
*.hsp
*.app
# Deck PDF exports (7-26 MB each): attach them to a release instead
deck/*.pdf

# Logs / dumps
*.log
hilog*.txt

# Editors / OS
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude local settings
.claude/settings.local.json

# Watch app runtime config (generated from watch/.env by watch/entry/hvigorfile.ts)
watch/entry/src/main/resources/rawfile/config.json

# Supabase CLI local state (supabase link / login)
**/supabase/.temp/

# Playwright MCP screenshots/logs (may show demo patient data)
.playwright-mcp/
