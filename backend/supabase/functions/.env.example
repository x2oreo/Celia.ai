# Copy to supabase/functions/.env for `supabase functions serve --env-file supabase/functions/.env`.
# In production set these with `supabase secrets set ...`. Never commit the real file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
# Optional overrides (defaults shown)
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_VISION_MODEL=gpt-6.1-sol
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional: openFDA key for drug-check tier 2 (works without one, at a lower rate limit)
OPENFDA_API_KEY=
# Local dev only (supabase-provided in production): Supabase URL + secret key for share / drug-check / box-identify
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: report link lifetime override for testing (default 48 h)
SHARE_REPORT_TTL_MINUTES=
